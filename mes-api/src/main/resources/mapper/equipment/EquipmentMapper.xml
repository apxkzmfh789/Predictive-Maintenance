<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.github.apxkzmfh789.mes.equipment.EquipmentMapper">

    <!-- 공통 컬럼 목록, 순서 = Equipment 레코드 필드 순서 -->

    <sql id="columns">
        equipment_id,
        equipment_code,
        equipment_name,
        location,
        status,
        is_active,
        created_at,
        updated_at
    </sql>

    <select id="findAll" resultType="io.github.apxkzmfh789.mes.equipment.Equipment">
        SELECT <include refid="columns"/>
        FROM equipment
        ORDER BY equipment_id
    </select>

    <select id="findById" resultType="io.github.apxkzmfh789.mes.equipment.Equipment">
        SELECT <include refid="columns"/>
        FROM equipment
        WHERE equipment_id = #{equipmentId}
    </select>

    <select id="findByCode" resultType="io.github.apxkzmfh789.mes.equipment.Equipment">
        SELECT <include refid="columns"/>
        FROM equipment
        WHERE equipment_code = #{equipmentCode}
    </select>

    <!-- status, is_active, created_at, updated_at은 DB DEFAULT로 채워짐 -->
    <insert id="insert">
        INSERT INTO equipment (equipment_code, equipment_name, location)
        VALUES (#{equipmentCode}, #{equipmentName}, #{location, jdbcType=NVARCHAR})
    </insert>

</mapper>

