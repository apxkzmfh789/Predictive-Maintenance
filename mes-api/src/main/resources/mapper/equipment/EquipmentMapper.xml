<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.github.apxkzmfh789.mes.equipment.EquipmentMapper">
    <!-- 컬럼 순서 = Equipment 레코드 필드 순서 -->
    <select id="findAll" resultType="io.github.apxkzmfh789.mes.equipment.Equipment">
        SELECT equipment_id,
               equipment_code,
               equipment_name,
               location,
               status,
               is_active,
               created_at,
               updated_at
        FROM equipment
        ORDER BY equipment_id
    </select>

</mapper>

